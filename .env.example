# ─────────────────────────────────────────────────────────────────────────────
# Sales & Marketing Tools — environment variables
# Copy to .env (local) or set in Vercel (staging) / Secret Manager + Cloud Run
# (production). Never commit real values. Values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL, used in e-mail links and as the push contact. No trailing slash.
APP_URL=http://localhost:3000
# ≥ 32 random characters. Signs the session cookie. Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Bearer token for /api/cron/* (Vercel Cron / Cloud Scheduler send "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=change-me-random

# ── Database (PostgreSQL: Neon on staging, Cloud SQL in production) ──────────
# App connection (pooled on Neon; Cloud SQL: unix socket or private IP).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Direct connection for migrations and the seed (Neon "unpooled"; Cloud SQL: same as DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Connections per instance (default 5). Keep instances × pool below the database limit.
DATABASE_POOL_MAX=5

# ── File storage (visit photos, avatars, board files) ───────────────────────
# vercel-blob (staging) | gcs (production) | local (development)
STORAGE_DRIVER=local
# vercel-blob: token of the PRIVATE Blob store (set automatically when the store is connected in Vercel).
BLOB_READ_WRITE_TOKEN=
# gcs: private bucket; credentials come from the Cloud Run service account (no key file).
GCS_BUCKET=
# local: folder for uploads (development only).
LOCAL_UPLOAD_DIR=./uploads

# ── E-mail (optional; without SMTP_HOST e-mails are only logged) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sales & Marketing Tools <no-reply@example.com>"

# ── Push notifications (Web Push / VAPID) — create once, never rotate ───────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Aroma journey webhook (POST /api/leads/journey) ─────────────────────────
# ≥ 32 random characters; same value as CRM_SYNC_KEY on the journey site.
JOURNEY_SYNC_KEY=

# ── Lead qualification (Batch 7) ─────────────────────────────────────────────
# on = AI layer judges free text; anything else = rules only.
QUALIFICATION_AI=off
# gemini (staging, GEMINI_API_KEY) | vertex (production, service account) | mock (tests/demo only)
QUALIFICATION_AI_PROVIDER=gemini
QUALIFICATION_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
# vertex: project id and region; the Cloud Run service account needs "Vertex AI User".
VERTEX_PROJECT=
VERTEX_LOCATION=asia-southeast1

# ── Seed (staging only — remove after the first deploy) ─────────────────────
# Password for the demo logins (≥ 10 chars). Dummy data only; never on production.
SEED_ADMIN_PASSWORD=
