# ── App ─────────────────────────────────────────────
APP_URL=http://localhost:3000
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -hex 32  (Vercel Cron / Cloud Scheduler send it as a Bearer token)
CRON_SECRET=

# ── Database (Postgres) ─────────────────────────────
# Staging: Neon (Singapore). Production: Cloud SQL for PostgreSQL.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Direct (non-pooled) URL for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5

# ── Storage ─────────────────────────────────────────
# vercel-blob (staging) | gcs (production)
STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
GCS_BUCKET=

# ── Email (SMTP) ─────────────────────────────────────
# Leave SMTP_HOST empty to log emails instead of sending (staging).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sales & Marketing Tools <no-reply@example.com>"

# ── Seeding (dummy data only) ───────────────────────
SEED_ADMIN_PASSWORD=
